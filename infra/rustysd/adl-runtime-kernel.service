[Unit]
Description=ADL supervised component runtime kernel proof
After=network.target

[Service]
Type=simple
ExecStartPre=/bin/sleep 2
ExecStart=/usr/local/bin/adl-runtime-kernel serve --init /etc/adl/runtime-v3.toml --continuity-root /var/lib/adl/runtime-v3/continuity
Restart=always

[Install]
WantedBy=multi-user.target
