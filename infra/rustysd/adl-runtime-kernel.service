[Unit]
Description=ADL supervised component runtime kernel proof
After=network.target

[Service]
Type=simple
ExecStartPre=/bin/sleep 2
ExecStart=/usr/local/bin/adl-runtime-kernel serve --init /etc/adl/runtime-v3.toml --capsule /var/lib/adl/runtime-kernel-continuity.json
Restart=always

[Install]
WantedBy=multi-user.target
