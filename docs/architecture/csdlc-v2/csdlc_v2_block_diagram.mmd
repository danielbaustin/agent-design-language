      validate["csdlc-validate"]
      publish["csdlc-publish"]
      closeout["csdlc-closeout"]
    end
    api["Typed command boundary\nJSON stdout • diagnostics stderr • typed exits"]
    subgraph core["Small shared C-SDLC library"]
      machine["Lifecycle state machine\ntyped transitions • guards • invariants"]
      cards["Automated card engine\ntyped values • templates • markdown.rs mdast"]
      design["Design readiness\nissue design • diagram • review"]
      claims["Session claims\nleases • heartbeats • protected paths"]
      scheduler["Deterministic scheduler\nreadiness • dependencies • budgets"]
      pvf["PVF\nlane selection • execution DAG • convergence"]
      shepherd["Shepherd observer\nwaiting • retry • repair • operator"]
      evidence["Evidence and projections\natomic records • digests • outcomes"]
    end
    subgraph adapters["Narrow adapters"]
      git["Git / worktree"]
      github["GitHub / Octocrab"]
      process["Bounded process runner"]
      files["Filesystem / schemas"]
    end
  end

  subgraph records["Issue-local durable truth"]
    prompts["SIP → STP → SPP → VPP → SRP → SOR"]
    index["Operational index"]
    designs["Design + Mermaid diagram"]
