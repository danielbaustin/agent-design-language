{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adl.v0918.external_review_output.v1",
  "type": "object",
  "required": ["schema", "target_sha", "corpus_sha256", "dispatch_receipt_sha256", "outcome", "findings", "residual_risks", "open_author_decisions"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "adl.v0918.external_review_output.v1"},
    "target_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "corpus_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "dispatch_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "outcome": {"enum": ["blocked", "deferred", "findings_returned", "no_findings"]},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "severity", "summary", "observed_evidence", "inference", "open_author_decision", "impact", "invariant", "failure_mode", "remediation", "residual_risk"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "severity": {"enum": ["P0", "P1", "P2", "P3"]},
          "summary": {"type": "string", "minLength": 1},
          "observed_evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "line_start", "line_end", "excerpt_sha256", "statement"],
              "properties": {
                "path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
                "line_start": {"type": "integer", "minimum": 1},
                "line_end": {"type": "integer", "minimum": 1},
                "excerpt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "statement": {"type": "string", "minLength": 1}
              }
            }
          },
          "inference": {"type": ["string", "null"]},
          "open_author_decision": {"type": ["string", "null"]},
          "impact": {"type": "string", "minLength": 1},
          "invariant": {"type": "string", "minLength": 1},
          "failure_mode": {"type": "string", "minLength": 1},
          "remediation": {"type": "string", "minLength": 1},
          "residual_risk": {"type": ["string", "null"]}
        }
      }
    },
    "residual_risks": {"type": "array", "items": {"type": "string"}},
    "open_author_decisions": {"type": "array", "items": {"type": "string"}}
  }
}
